+# @date    2026-11-19
+
+"""Compare battery-terminal energy rates on one identical 1 s braking trace."""
+
+import os
+import subprocess
+import sys
+import xml.etree.ElementTree as ET
+
+sys.path.append(os.path.join(os.environ["SUMO_HOME"], "tools"))
+from sumolib import checkBinary  # noqa
+
+
+# A constant-speed descent can also saturate the motor. On level road,
+# 20 -> 19.8 m/s stays below both limits. Hard braking at speed hits the power
+# ceiling. The 4 -> 0 m/s stop hits the torque ceiling at 2 m/s mean speed.
+# 100 Nm * 4 / 0.4 m gives 1000 N. With both limits the 4 -> 0 m/s step
+# therefore returns (2000 W * 0.5 - 250 W) / 3600 = 0.208333 Wh.
+# On 10 -> 0 m/s, the first half second delivers 5 kW; the next half
+# averages 2.5 kW. This recovers 3750 J mechanically, or 0.451389 Wh net.
+print("vehicle: net electricity (Wh/s), in timeline order")
+for vtype in ET.parse("input_additional.add.xml").getroot().findall("vType"):
+    name = vtype.attrib["id"]
+    subprocess.check_call([checkBinary("emissionsDrivingCycle"), "--quiet",
+                           "--timeline-file", "data.csv", "--additional-files", "input_additional.add.xml",
+                           "--have-slope", "--vtype", name,
+                           "--output.attributes", "electricity_abs", "-o", "rates.csv"])
+    with open("rates.csv") as rates:
+        print("%s: %s" % (name, " ".join(line.split(";")[1].strip() for line in rates)))
