+double
+HelpersEnergy::computeRecuperationPower(double brakePower, const double lastV, const double v, const EnergyParams& param) {
+    const double maxTorque = param.getDoubleOptional(SUMO_ATTR_MAXIMUMRECUPERATIONTORQUE, INVALID_DOUBLE);
+    const double maxPower = param.getDoubleOptional(SUMO_ATTR_MAXIMUMRECUPERATIONPOWER, INVALID_DOUBLE);
+    if (maxTorque == INVALID_DOUBLE && maxPower == INVALID_DOUBLE) {
+        return brakePower;
+    }
+    const double lowSpeed = MIN2(fabs(lastV), fabs(v));
+    const double highSpeed = MAX2(fabs(lastV), fabs(v));
+    const double meanSpeed = 0.5 * (lowSpeed + highSpeed);
+    if (maxTorque != INVALID_DOUBLE) {
+        const double gearRatio = param.getDoubleOptional(SUMO_ATTR_GEARRATIO, 10.);
+        const double wheelRadius = param.getDoubleOptional(SUMO_ATTR_WHEELRADIUS, 0.3588);
+        const double maxForce = wheelRadius > 0 ? MAX2(0., maxTorque) * MAX2(0., gearRatio) / wheelRadius : 0.;
+        brakePower = MIN2(brakePower, maxForce * meanSpeed);
+    }
+    if (maxPower == INVALID_DOUBLE) {
+        return brakePower;
+    }
+    const double limit = MAX2(0., maxPower);
+    if (lowSpeed < highSpeed && meanSpeed > 0.) {
+        // Spread the braking work over the step at constant force, so power varies linearly with speed.
+        const double lowPower = brakePower * (lowSpeed / meanSpeed);
+        const double highPower = brakePower * (highSpeed / meanSpeed);
+        if (lowPower < limit && limit < highPower) {
+            // Below the crossing speed the motor recovers less than the limit (a triangle in power vs time).
+            const double belowLimitFraction = (limit - lowPower) / (highPower - lowPower);
+            return limit - 0.5 * (limit - lowPower) * belowLimitFraction;
+        }
+    }
+    return MIN2(brakePower, limit);
+}
